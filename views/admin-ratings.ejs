<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Likes & Bests Dashboard</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <nav class="navbar">
    <a href="/skills" class="nav-brand">Skill Reel Rater</a>
    <span class="nav-user">
      <%= user.first_name %> | <a href="/skills">Skills</a> | <a href="/admin/raters">Rater Analytics</a> | <a href="/logout">Logout</a>
    </span>
  </nav>
  <main class="container">
    <h1>Admin Dashboard</h1>

    <div class="analytics-grid">
      <div class="analytics-card">
        <div class="analytics-value"><%= analytics.totalLikes %></div>
        <div class="analytics-label">Total Likes</div>
      </div>
      <div class="analytics-card">
        <div class="analytics-value"><%= analytics.totalBests %></div>
        <div class="analytics-label">Best of the Best</div>
      </div>
      <div class="analytics-card">
        <div class="analytics-value"><%= analytics.uniqueRaters %></div>
        <div class="analytics-label">Unique Raters</div>
      </div>
      <div class="analytics-card">
        <div class="analytics-value"><%= analytics.uniqueSkills %></div>
        <div class="analytics-label">Skills Liked</div>
      </div>
      <div class="analytics-card">
        <div class="analytics-value"><%= analytics.uniquePerformers %></div>
        <div class="analytics-label">Performers Liked</div>
      </div>
      <div class="analytics-card">
        <div class="analytics-value"><%= analytics.brokenCount + analytics.notSkillReelCount + analytics.noDemoCount %></div>
        <div class="analytics-label">Total Flags</div>
      </div>
    </div>

    <!-- Engagement Tracking -->
    <div class="analytics-section" style="margin-bottom:20px;">
      <h3>Engagement This Week</h3>
      <div class="analytics-grid" style="margin-bottom:16px;">
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.likesToday %></div>
          <div class="analytics-label">Likes Today</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.likesThisWeek %></div>
          <div class="analytics-label">Likes This Week</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.bestsThisWeek %></div>
          <div class="analytics-label">Bests This Week</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.activeRatersWeek %></div>
          <div class="analytics-label">Active Raters</div>
        </div>
      </div>
      <div class="analytics-grid">
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.stuntLikes %></div>
          <div class="analytics-label">Stunt Reel Likes</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.stuntBests %></div>
          <div class="analytics-label">Stunt Reel Bests</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.activeFeedbackRequests %></div>
          <div class="analytics-label">Active Feedback Requests</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.totalFeedbackSubmissions %></div>
          <div class="analytics-label">Feedback Submitted</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.feedbackThisWeek %></div>
          <div class="analytics-label">Feedback This Week</div>
        </div>
        <div class="analytics-card">
          <div class="analytics-value"><%= engagement.hiddenReelsCount %></div>
          <div class="analytics-label">Hidden Reels</div>
        </div>
      </div>
    </div>

    <!-- Daily Activity Chart (14 days) -->
    <div class="analytics-section" style="margin-bottom:20px;">
      <h3>Daily Activity (Last 14 Days)</h3>
      <div class="section-desc">Likes per day</div>
      <%
        const dailyMap = {};
        engagement.dailyLikes.forEach(d => { dailyMap[d.day] = (dailyMap[d.day] || 0) + d.count; });
        const days = [];
        for (let i = 13; i >= 0; i--) {
          const d = new Date();
          d.setDate(d.getDate() - i);
          const key = d.toISOString().split('T')[0];
          days.push({ day: key, label: (d.getMonth()+1) + '/' + d.getDate(), count: dailyMap[key] || 0 });
        }
        const maxDayCount = Math.max(1, ...days.map(d => d.count));
      %>
      <div class="bar-chart" style="height:120px;">
        <% days.forEach(d => { %>
          <div class="bar-col">
            <div class="bar-count"><%= d.count || '' %></div>
            <div class="bar" style="height:<%= Math.max(2, (d.count / maxDayCount) * 100) %>%;"></div>
            <div class="bar-label"><%= d.label %></div>
          </div>
        <% }) %>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:24px;">
      <div class="analytics-table-card">
        <h3>Most Liked Performers</h3>
        <table class="admin-table compact">
          <thead><tr><th>Performer</th><th>Likes</th></tr></thead>
          <tbody>
            <% analytics.topPerformers.forEach(p => { %>
              <tr><td><%= p.name %></td><td class="rating-cell"><%= p.count %></td></tr>
            <% }) %>
            <% if (analytics.topPerformers.length === 0) { %>
              <tr><td colspan="2" style="text-align:center;color:#8b949e;">No data yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="analytics-table-card">
        <h3>Most Liked Skills</h3>
        <table class="admin-table compact">
          <thead><tr><th>Skill</th><th>Likes</th></tr></thead>
          <tbody>
            <% analytics.topSkills.forEach(s => { %>
              <tr><td><%= s.name %></td><td class="rating-cell"><%= s.count %></td></tr>
            <% }) %>
            <% if (analytics.topSkills.length === 0) { %>
              <tr><td colspan="2" style="text-align:center;color:#8b949e;">No data yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="analytics-table-card">
        <h3>Best of the Best</h3>
        <table class="admin-table compact">
          <thead><tr><th>Performer</th><th>Skill</th><th>Votes</th></tr></thead>
          <tbody>
            <% analytics.bestLeaderboard.forEach(b => { %>
              <tr><td><%= b.performer_name %></td><td><%= b.skill_name %></td><td class="rating-cell"><%= b.count %></td></tr>
            <% }) %>
            <% if (analytics.bestLeaderboard.length === 0) { %>
              <tr><td colspan="3" style="text-align:center;color:#8b949e;">No data yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <h2>Likes Log</h2>
    <form method="GET" action="/admin/ratings">
      <table class="admin-table">
        <thead>
          <tr><th>When</th><th>Rater</th><th>Skill</th><th>Performer</th></tr>
          <tr class="filter-row">
            <td>
              <select name="date" onchange="this.form.submit()">
                <option value="">All</option>
                <% dateOptions.forEach(d => { %>
                  <option value="<%= d %>" <%= filters.date === d ? 'selected' : '' %>><%= d %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <select name="rater" onchange="this.form.submit()">
                <option value="">All</option>
                <% raterOptions.forEach(r => { %>
                  <option value="<%= r.id %>" <%= filters.rater == r.id ? 'selected' : '' %>><%= r.name %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <select name="skill" onchange="this.form.submit()">
                <option value="">All</option>
                <% skillOptions.forEach(s => { %>
                  <option value="<%= s %>" <%= filters.skill === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <select name="performer" onchange="this.form.submit()">
                <option value="">All</option>
                <% performerOptions.forEach(p => { %>
                  <option value="<%= p.id %>" <%= filters.performer == p.id ? 'selected' : '' %>><%= p.name %></option>
                <% }) %>
              </select>
            </td>
          </tr>
        </thead>
        <tbody>
          <% likes.forEach(r => { %>
            <tr>
              <td><%= r.created_at ? r.created_at.replace('T', ' ').substring(0, 16) : '' %></td>
              <td><%= r.rater_name %></td>
              <td><%= r.skill_name %></td>
              <td><%= r.performer_name %></td>
            </tr>
          <% }) %>
          <% if (likes.length === 0) { %>
            <tr><td colspan="4" style="text-align:center;color:#8b949e;">No likes yet</td></tr>
          <% } %>
        </tbody>
      </table>
    </form>
  </main>
</body>
</html>
