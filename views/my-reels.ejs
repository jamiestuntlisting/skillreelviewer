<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Reels - Skill Reel Rater</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <nav class="navbar">
    <a href="/skills" class="nav-brand">Skill Reel Rater</a>
    <% if (user) { %>
      <span class="nav-user">
        <%= user.first_name %>
        | <a href="/my-reels"><strong>My Reels</strong></a>
        | <a href="/feedback">Feedback</a>
        <% if (user.id === 33) { %> | <a href="/admin/ratings">Admin</a><% } %>
        | <a href="/logout">Logout</a>
      </span>
    <% } %>
  </nav>
  <main class="container">
    <h1>My Reels</h1>
    <p class="subtitle"><%= reels.length %> skill reel<%= reels.length !== 1 ? 's' : '' %></p>

    <% if (reels.length === 0) { %>
      <div class="empty-state">
        <p>You don't have any skill reels yet.</p>
        <p>Add skill reels on <a href="https://www.stuntlisting.com" target="_blank" rel="noopener">StuntListing</a> to manage them here.</p>
      </div>
    <% } else { %>
      <div class="my-reels-list">
        <% reels.forEach(reel => { %>
          <div class="reel-row" data-skill-set-id="<%= reel.skill_set_id %>" data-reel-type="<%= reel.reelType || 'skill' %>">
            <% if (reel.skillEmbed && reel.skillEmbed.thumbnail) { %>
              <img src="<%= reel.skillEmbed.thumbnail %>" alt="<%= reel.skill_name %>" class="reel-row-thumb">
            <% } else { %>
              <div class="reel-row-thumb reel-row-thumb-placeholder">&#9654;</div>
            <% } %>
            <div class="reel-row-info">
              <div class="reel-skill-name"><%= reel.skill_name %></div>
              <div class="reel-row-meta">
                <% if (reel.reelType === 'stunt') { %>
                  <span class="status-badge" style="background:#2d2a1f;color:#f0c040;border:1px solid #5c5020;">Stunt Reel</span>
                <% } else if (reel.level && reel.level !== 'Not rated') { %>
                  <span class="reel-level"><%= reel.level %></span>
                <% } %>
                <div class="reel-status-badges">
                  <% if (reel.isHidden) { %>
                    <span class="status-badge status-hidden">Hidden</span>
                  <% } %>
                  <% if (reel.feedbackRequest) { %>
                    <span class="status-badge status-feedback-open">Feedback Open</span>
                  <% } %>
                  <% if (reel.feedbackCount > 0) { %>
                    <span class="status-badge status-feedback-count"><%= reel.feedbackCount %> feedback</span>
                  <% } %>
                </div>
              </div>
            </div>
            <% if (reel.reelType !== 'stunt') { %>
              <div class="reel-row-actions">
                <button class="reel-action-btn hide-btn<%= reel.isHidden ? ' hide-active' : '' %>"
                        onclick="toggleHide(<%= reel.skill_set_id %>, this)">
                  <%= reel.isHidden ? 'Unhide' : 'Hide from Rating' %>
                </button>
                <% if (!reel.feedbackRequest) { %>
                  <button class="reel-action-btn feedback-req-btn"
                          onclick="showFeedbackConfirm(<%= reel.skill_set_id %>, this)">
                    Request Feedback
                  </button>
                <% } else { %>
                  <a href="/feedback/<%= reel.feedbackRequest.request_id %>" class="reel-action-btn feedback-active">
                    View Feedback
                  </a>
                <% } %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
    <!-- Feedback confirmation modal -->
    <div id="feedback-confirm-modal" class="hidden-modal-overlay" onclick="if(event.target===this)closeFeedbackModal()">
      <div class="hidden-modal">
        <h3>Request Feedback</h3>
        <p>Your reel will be visible for feedback for the next two weeks.</p>
        <p>You may get feedback that is negative or mean spirited. Be ready for that. Getting feedback can be very difficult and everyone has opinions. If you think a message is hateful, please report it to us at <a href="mailto:info@stuntlisting.com">info@stuntlisting.com</a></p>
        <div style="display:flex; gap:8px; margin-top:16px;">
          <button class="modal-close-btn" onclick="closeFeedbackModal()" style="flex:1;">Cancel</button>
          <button id="feedback-confirm-btn" class="feedback-submit-btn" onclick="confirmFeedbackRequest()" style="flex:1;">Request Feedback</button>
        </div>
      </div>
    </div>
  </main>
  <script>
    async function toggleHide(skillSetId, btn) {
      try {
        const res = await fetch('/my-reels/hide', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ skill_set_id: skillSetId }),
        });
        if (res.ok) {
          const data = await res.json();
          btn.textContent = data.hidden ? 'Unhide' : 'Hide from Rating';
          btn.classList.toggle('hide-active', data.hidden);
          const row = btn.closest('.reel-row');
          const badges = row.querySelector('.reel-status-badges');
          const existingHidden = badges.querySelector('.status-hidden');
          if (data.hidden && !existingHidden) {
            const badge = document.createElement('span');
            badge.className = 'status-badge status-hidden';
            badge.textContent = 'Hidden';
            badges.prepend(badge);
          } else if (!data.hidden && existingHidden) {
            existingHidden.remove();
          }
        }
      } catch (err) {
        console.error('Hide toggle failed:', err);
      }
    }

    let pendingFeedbackId = null;
    let pendingFeedbackBtn = null;

    function showFeedbackConfirm(skillSetId, btn) {
      pendingFeedbackId = skillSetId;
      pendingFeedbackBtn = btn;
      document.getElementById('feedback-confirm-modal').style.display = 'flex';
    }

    function closeFeedbackModal() {
      document.getElementById('feedback-confirm-modal').style.display = 'none';
      pendingFeedbackId = null;
      pendingFeedbackBtn = null;
    }

    async function confirmFeedbackRequest() {
      if (!pendingFeedbackId || !pendingFeedbackBtn) return;
      const btn = pendingFeedbackBtn;
      const skillSetId = pendingFeedbackId;
      closeFeedbackModal();
      try {
        const res = await fetch('/my-reels/request-feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ skill_set_id: skillSetId }),
        });
        if (res.ok) {
          btn.textContent = 'Feedback Requested';
          btn.disabled = true;
          btn.classList.add('feedback-active');
          const row = btn.closest('.reel-row');
          const badges = row.querySelector('.reel-status-badges');
          const badge = document.createElement('span');
          badge.className = 'status-badge status-feedback-open';
          badge.textContent = 'Feedback Open';
          badges.appendChild(badge);
        } else if (res.status === 409) {
          btn.textContent = 'Already requested';
          btn.disabled = true;
        }
      } catch (err) {
        console.error('Feedback request failed:', err);
      }
    }
  </script>
</body>
</html>
