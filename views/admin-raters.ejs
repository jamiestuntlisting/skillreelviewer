<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Rater Analytics</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <nav class="navbar">
    <a href="/skills" class="nav-brand">Skill Reel Rater</a>
    <span class="nav-user">
      <%= user.first_name %> | <a href="/admin/ratings">Dashboard</a> | <a href="/logout">Logout</a>
    </span>
  </nav>
  <main class="container">
    <h1>Rater Analytics</h1>
    <p class="subtitle"><%= raters.length %> rater<%= raters.length !== 1 ? 's' : '' %></p>

    <div class="raters-grid">
      <% raters.forEach(r => { %>
        <div class="rater-card">
          <h3><%= r.name %></h3>
          <% if (r.email) { %><p class="rater-email"><%= r.email %></p><% } %>
          <div class="rater-stats">
            <span>&#128077; <strong><%= r.totalLikes %></strong> likes</span>
            <span>&#9733; <strong><%= r.totalBests %></strong> bests</span>
            <span><strong><%= r.skillsLikedCount %></strong> skills</span>
            <span><strong><%= r.totalFlags %></strong> flags</span>
          </div>
          <% if (r.totalFlags > 0) { %>
            <div class="rater-flags">
              <% if (r.flags.broken_link) { %><span class="flag-chip">Broken: <%= r.flags.broken_link %></span><% } %>
              <% if (r.flags.not_skill_reel) { %><span class="flag-chip">Not Reel: <%= r.flags.not_skill_reel %></span><% } %>
              <% if (r.flags.no_demo) { %><span class="flag-chip">No Demo: <%= r.flags.no_demo %></span><% } %>
            </div>
          <% } %>
          <% if (r.lastActivity) { %>
            <p class="rater-last-active">Last active: <%= r.lastActivity.substring(0, 16).replace('T', ' ') %></p>
          <% } %>
          <p><a href="/admin/ratings?rater=<%= r.id %>">View likes &rarr;</a></p>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
